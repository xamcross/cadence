{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4200/",
        "http://localhost:4200/resources/reducing-interview-no-shows",
        "http://localhost:4200/schedule?token=lighthouse-demo",
        "http://localhost:4200/terms",
        "http://localhost:4200/privacy"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "devtools",
        "screenEmulation": {
          "mobile": true,
          "width": 375,
          "height": 667,
          "deviceScaleFactor": 2
        }
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "http://localhost:4200/(resources.*)?$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.8 }],
            "categories:accessibility": ["warn", { "minScore": 0.95 }],
            "categories:seo": ["warn", { "minScore": 0.9 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2000 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:4200/(schedule|booking|confirm|status|feedback|request-access).*",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["warn", { "minScore": 0.95 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2000 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:4200/(terms|privacy)$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["warn", { "minScore": 0.95 }],
            "categories:seo": ["warn", { "minScore": 0.9 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2000 }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
