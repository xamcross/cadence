{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4200/schedule?token=lighthouse-demo",
        "http://localhost:4200/booking?token=lighthouse-demo",
        "http://localhost:4200/booking/cancel?token=lighthouse-demo",
        "http://localhost:4200/confirm?token=lighthouse-demo",
        "http://localhost:4200/status?token=lighthouse-demo"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "screenEmulation": {
          "mobile": true,
          "width": 375,
          "height": 667,
          "deviceScaleFactor": 2
        }
      }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2000 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
