<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="springAppName" source="spring.application.name"/>

    <!--
      Structured JSON to STDOUT for every profile (dev, test, production).

      Containers (Fly.io) and CI capture stdout, so that is the only sink we need. Writing to a
      file inside the container is a 12-factor anti-pattern and actively fails here: the image
      runs as the non-root 'cadence' user and cannot create /app/logs, so a file appender crashes
      the app on startup. Emitting JSON to stdout also keeps the CI PII scan (which greps stdout)
      meaningful. Zero PII at any level per Principle VIII - use StructuredArguments at call sites.
    -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"application":"${springAppName}"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>

</configuration>
