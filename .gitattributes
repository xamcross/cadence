# Default: normalize to LF in repo, checkout as-is on all platforms
* text=auto eol=lf

# Windows-executed scripts: CRLF on checkout
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Explicitly LF: Linux-consumed config and source files
Dockerfile    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.conf        text eol=lf
*.env         text eol=lf
*.java        text eol=lf
*.ts          text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.scss        text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.xml         text eol=lf
*.sh          text eol=lf

# Binary: no line-ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.jar   binary
*.zip   binary
*.pdf   binary
